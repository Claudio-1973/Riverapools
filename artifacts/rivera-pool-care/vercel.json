{
  "version": 2,
  "framework": null,
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/murrieta",
      "destination": "/murrieta/index.html"
    },
    {
      "source": "/temecula",
      "destination": "/temecula/index.html"
    },
    {
      "source": "/lake-elsinore",
      "destination": "/lake-elsinore/index.html"
    },
    {
      "source": "/winchester",
      "destination": "/winchester/index.html"
    },
    {
      "source": "/canyon-lake",
      "destination": "/canyon-lake/index.html"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
