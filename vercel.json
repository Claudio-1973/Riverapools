{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "BASE_PATH=/ pnpm --filter @workspace/mockup-sandbox run build",
  "outputDirectory": "artifacts/mockup-sandbox/dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "riverapoolsriverside.com"
        }
      ],
      "destination": "https://www.riverapoolsriverside.com/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/review",
      "destination": "/index.html"
    },
    {
      "source": "/riverside",
      "destination": "/riverside/index.html"
    },
    {
      "source": "/temecula",
      "destination": "/temecula/index.html"
    },
    {
      "source": "/murrieta",
      "destination": "/murrieta/index.html"
    },
    {
      "source": "/menifee",
      "destination": "/menifee/index.html"
    },
    {
      "source": "/hemet",
      "destination": "/hemet/index.html"
    },
    {
      "source": "/corona",
      "destination": "/corona/index.html"
    },
    {
      "source": "/fallbrook",
      "destination": "/fallbrook/index.html"
    },
    {
      "source": "/bonsall",
      "destination": "/bonsall/index.html"
    },
    {
      "source": "/vista",
      "destination": "/vista/index.html"
    },
    {
      "source": "/oceanside",
      "destination": "/oceanside/index.html"
    },
    {
      "source": "/pool-finishes/quartz",
      "destination": "/pool-finishes/quartz/index.html"
    },
    {
      "source": "/pool-finishes/pebble",
      "destination": "/pool-finishes/pebble/index.html"
    },
    {
      "source": "/pool-finishes/stone-scapes",
      "destination": "/pool-finishes/stone-scapes/index.html"
    },
    {
      "source": "/pool-finishes/diamond-brite",
      "destination": "/pool-finishes/diamond-brite/index.html"
    },
    {
      "source": "/travertine-coping",
      "destination": "/travertine-coping/index.html"
    },
    {
      "source": "/pool-plaster-delaminating",
      "destination": "/pool-plaster-delaminating/index.html"
    },
    {
      "source": "/rough-pool-plaster-repair",
      "destination": "/rough-pool-plaster-repair/index.html"
    },
    {
      "source": "/baja-shelf-addition-cost",
      "destination": "/baja-shelf-addition-cost/index.html"
