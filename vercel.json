{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "BASE_PATH=/ pnpm --filter @workspace/mockup-sandbox run build",
  "outputDirectory": "artifacts/mockup-sandbox/dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "riverapoolsriverside.com" }
      ],
      "destination": "https://www.riverapoolsriverside.com/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
